<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <meta name="description" content="Play professional chess online in real-time. Features live clocks, captured pieces, move notation, and multiplayer chat.">
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Preload critical piece assets -->
    <link rel="preload" href="/img/pieces/wK.svg" as="image">
    <link rel="preload" href="/img/pieces/bK.svg" as="image">
</head>
<body>
    <div class="app">
        <!-- ─── NAVBAR ─────────────────────────────────────────────── -->
        <header class="navbar">
            <div class="navbar-left">
                <a href="/" class="brand">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2L9 7H6l-1 4h2l-2 8h14l-2-8h2l-1-4h-3L12 2z" fill="var(--accent-emerald)" stroke="var(--accent-emerald)"/>
                        </svg>
                    </div>
                    <span class="brand-name">Chess<span>Arena</span></span>
                    <span class="brand-tag">PRO</span>
                </a>

                <nav class="nav-links">
                    <a href="#" class="nav-item active" id="navLobby" title="Home Lobby">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                        </svg>
                        <span>Home</span>
                    </a>
                    <a href="#" class="nav-item" id="navPlay" title="Play Board">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-8 14H7v-4h4v4zm0-6H7V7h4v4zm6 6h-4v-4h4v4zm0-6h-4V7h4v4z"/>
                        </svg>
                        <span>Play</span>
                    </a>
                    <a href="#" class="nav-item" id="navPuzzles" title="Daily Puzzles">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/>
                        </svg>
                        <span>Puzzles</span>
                    </a>
                    <a href="#" class="nav-item" id="navHistory" title="Game History">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>History</span>
                    </a>
                    <a href="#" class="nav-item" id="navProfile" title="Player Profile">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>Profile</span>
                    </a>
                </nav>
            </div>

            <div class="navbar-right">
                <button class="btn-nav-active-game" id="btnNavActiveGame" style="display: none;" title="Return to ongoing match">
                    <span class="active-game-dot"></span> Active Match ➔
                </button>

                <div class="connection-status" id="connectionPill">
                    <span class="status-indicator-dot" id="connectionDot"></span>
                    <span class="status-indicator-text" id="connectionText">Connected</span>
                </div>

                <div class="user-menu" id="userMenu" title="View Profile & Stats">
                    <div class="user-avatar" id="myNavAvatar">
                        <span>GM</span>
                    </div>
                    <div class="user-info-text">
                        <span class="user-name" id="myNavName">Player</span>
                        <span class="user-rating-badge" id="myNavRating">1540</span>
                    </div>
                    <svg class="menu-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
            </div>
        </header>

        <!-- ─── HOMEPAGE & LOBBY VIEW (PHASE 9) ────────────────────── -->
        <section class="lobby-view" id="lobbyView">
            <div class="lobby-container">
                <!-- Hero Header -->
                <div class="lobby-hero">
                    <div class="hero-content">
                        <div class="hero-badge">
                            <span class="pulse-dot"></span> Online Chess Arena
                        </div>
                        <h1 class="hero-title">Play Chess Online</h1>
                        <p class="hero-subtitle">Compete against players worldwide, challenge friends with custom rooms, or solve grandmaster puzzles.</p>
                        <div class="hero-stats">
                            <div class="hero-stat-item">
                                <span class="stat-number">1,420</span>
                                <span class="stat-label">Players Online</span>
                            </div>
                            <div class="hero-stat-divider"></div>
                            <div class="hero-stat-item">
                                <span class="stat-number">642</span>
                                <span class="stat-label">Active Games</span>
                            </div>
                            <div class="hero-stat-divider"></div>
                            <div class="hero-stat-item">
                                <span class="stat-number" id="lobbyUserRating">1540</span>
                                <span class="stat-label">Your Rapid ELO</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lobby Main Content Grid -->
                <div class="lobby-grid">
                    <!-- Left: Play Online Time Control Matrix & Matchmaking Card -->
                    <div class="lobby-card play-online-card">
                        <div class="card-header">
                            <div class="card-title-wrap">
                                <div class="card-icon bg-emerald">⚡</div>
                                <div>
                                    <h2 class="card-title">Play Online</h2>
                                    <p class="card-desc">Select time control & find a matched opponent</p>
                                </div>
                            </div>
                            <span class="pill-category">Live Match</span>
                        </div>

                        <!-- Time Control Group: BULLET -->
                        <div class="tc-section">
                            <div class="tc-group-header">
                                <span class="tc-group-icon">🚀</span>
                                <span class="tc-group-name">BULLET</span>
                            </div>
                            <div class="tc-buttons-grid">
                                <button type="button" class="tc-choice-btn" data-tc="1+0">
                                    <span class="tc-btn-time">1+0</span>
                                    <span class="tc-btn-type">Bullet</span>
                                </button>
                                <button type="button" class="tc-choice-btn" data-tc="2+1">
                                    <span class="tc-btn-time">2+1</span>
                                    <span class="tc-btn-type">Bullet</span>
                                </button>
                            </div>
                        </div>

                        <!-- Time Control Group: BLITZ -->
                        <div class="tc-section">
                            <div class="tc-group-header">
                                <span class="tc-group-icon">⚡</span>
                                <span class="tc-group-name">BLITZ</span>
                            </div>
                            <div class="tc-buttons-grid">
                                <button type="button" class="tc-choice-btn" data-tc="3+0">
                                    <span class="tc-btn-time">3+0</span>
                                    <span class="tc-btn-type">Blitz</span>
                                </button>
                                <button type="button" class="tc-choice-btn" data-tc="3+2">
                                    <span class="tc-btn-time">3+2</span>
                                    <span class="tc-btn-type">Blitz</span>
                                </button>
                                <button type="button" class="tc-choice-btn" data-tc="5+0">
                                    <span class="tc-btn-time">5+0</span>
                                    <span class="tc-btn-type">Blitz</span>
                                </button>
                            </div>
                        </div>

                        <!-- Time Control Group: RAPID -->
                        <div class="tc-section">
                            <div class="tc-group-header">
                                <span class="tc-group-icon">⏱️</span>
                                <span class="tc-group-name">RAPID</span>
                                <span class="badge-popular">Popular</span>
                            </div>
                            <div class="tc-buttons-grid">
                                <button type="button" class="tc-choice-btn selected" data-tc="10+0">
                                    <span class="tc-btn-time">10+0</span>
                                    <span class="tc-btn-type">Rapid</span>
                                </button>
                                <button type="button" class="tc-choice-btn" data-tc="10+5">
                                    <span class="tc-btn-time">10+5</span>
                                    <span class="tc-btn-type">Rapid</span>
                                </button>
                            </div>
                        </div>

                        <!-- Time Control Group: CLASSICAL -->
                        <div class="tc-section">
                            <div class="tc-group-header">
                                <span class="tc-group-icon">⏳</span>
                                <span class="tc-group-name">CLASSICAL</span>
                            </div>
                            <div class="tc-buttons-grid">
                                <button type="button" class="tc-choice-btn" data-tc="30+0">
                                    <span class="tc-btn-time">30+0</span>
                                    <span class="tc-btn-type">Classical</span>
                                </button>
                            </div>
                        </div>

                        <!-- Find Opponent Button -->
                        <div class="find-opponent-wrap">
                            <button type="button" class="btn-find-opponent" id="btnFindOpponent">
                                <span class="find-icon">⚔️</span>
                                <span class="find-text">FIND OPPONENT</span>
                                <span class="find-badge" id="selectedTcBadge">10+0 • Rapid</span>
                            </button>
                        </div>
                    </div>

                    <!-- Right: Quick Modes List -->
                    <div class="lobby-side-modes">
                        <!-- 1. Play with Friend -->
                        <div class="mode-card" id="modeFriend">
                            <div class="mode-icon-wrap bg-blue">👥</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Play with Friend</h3>
                                <p class="mode-desc">Share a private match link or room code</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>

                        <!-- 2. Create Game -->
                        <div class="mode-card" id="modeCreateGame">
                            <div class="mode-icon-wrap bg-purple">➕</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Create Game</h3>
                                <p class="mode-desc">Custom time control, rating, and color</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>

                        <!-- 3. Join Game -->
                        <div class="mode-card" id="modeJoinGame">
                            <div class="mode-icon-wrap bg-amber">🔍</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Join Game</h3>
                                <p class="mode-desc">Enter an invite code to join friend's match</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>

                        <!-- 4. Play vs Computer -->
                        <div class="mode-card" id="modeVsBot">
                            <div class="mode-icon-wrap bg-green">🤖</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Play vs Computer</h3>
                                <p class="mode-desc">Practice offline against adaptive chess bots</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>

                        <!-- 5. Puzzles -->
                        <div class="mode-card" id="modePuzzles">
                            <div class="mode-icon-wrap bg-orange">🧩</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Puzzles</h3>
                                <p class="mode-desc">Solve daily tactical puzzles & level up</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>

                        <!-- 6. Game History -->
                        <div class="mode-card" id="modeHistory">
                            <div class="mode-icon-wrap bg-teal">📜</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Game History</h3>
                                <p class="mode-desc">Review your past games, results, and moves</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>

                        <!-- 7. Profile -->
                        <div class="mode-card" id="modeProfile">
                            <div class="mode-icon-wrap bg-rose">👤</div>
                            <div class="mode-info">
                                <h3 class="mode-title">Profile</h3>
                                <p class="mode-desc">Stats, ratings, win rate, and achievements</p>
                            </div>
                            <span class="mode-arrow">➔</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─── MAIN GAME LAYOUT ───────────────────────────────────── -->
        <main class="main-layout" id="gameView" style="display: none;">
            <!-- ── Left/Center: Game Viewport ── -->
            <section class="game-viewport">
                <!-- Private Match Header Banner (Phase 10) -->
                <div class="private-room-bar" id="privateRoomBar" style="display: none;">
                    <div class="room-pill">
                        <span class="lock-icon">🔒</span>
                        <span>Private Game: <strong id="gameRoomCode">ARENA-0000</strong></span>
                    </div>
                    <button class="btn-copy-code-pill" id="btnCopyRoomCode" title="Copy Invite Link">
                        📋 Copy Link
                    </button>
                    <div class="spectator-indicator-pill" id="spectatorIndicatorPill" style="display: none;">
                        👁️ Spectator Mode (Interactions Disabled)
                    </div>
                </div>

                <!-- Opponent Strip -->
                <div class="player-strip opponent" id="opponentBar">
                    <div class="player-meta">
                        <div class="avatar-wrap">
                            <div class="avatar" id="opponentAvatar" style="background: linear-gradient(135deg, #10b981, #059669);">
                                <span id="opponentAvatarText">OP</span>
                            </div>
                            <span class="online-indicator" id="opponentOnlineDot" title="Online"></span>
                        </div>
                        <div class="player-text">
                            <div class="name-rating-row">
                                <span class="player-name" id="opponentName">Opponent</span>
                                <span class="rating-badge" id="opponentRating">1515</span>
                                <span class="player-role-tag" id="opponentLabel">Waiting...</span>
                            </div>
                            <!-- Opponent captured pieces tray -->
                            <div class="captured-tray" id="opponentCaptured">
                                <div class="captured-pieces" id="opponentCapturedPieces"></div>
                                <span class="material-lead" id="opponentMaterialLead"></span>
                            </div>
                        </div>
                    </div>

                    <div class="player-timing">
                        <div class="turn-indicator" id="opponentTurnBadge">
                            <span class="turn-dot"></span>
                            <span class="turn-text">TURN</span>
                        </div>
                        <div class="clock-wrap">
                            <div class="chess-clock" id="opponentClock">10:00</div>
                            <span class="increment-indicator" id="opponentIncrement"></span>
                        </div>
                    </div>
                </div>

                <!-- Board Frame with Coordinates -->
                <div class="board-frame" id="boardWrapper">
                    <div class="rank-labels" id="rankLabels"></div>
                    <div class="chessboard" id="chessboard"></div>
                    <div class="file-labels" id="fileLabels"></div>
                    <!-- Historical Review Floating Banner -->
                    <div class="review-status-banner" id="reviewBanner">
                        <span class="review-status-text" id="reviewStatusText">Viewing move #1</span>
                        <button class="btn-exit-review" id="btnExitReview">Return to Live ➔</button>
                    </div>
                </div>

                <!-- User Player Strip -->
                <div class="player-strip player" id="playerBar">
                    <div class="player-meta">
                        <div class="avatar-wrap">
                            <div class="avatar" id="playerAvatar" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8);">
                                <span id="playerAvatarText">ME</span>
                            </div>
                            <span class="online-indicator" id="playerOnlineDot" title="Online"></span>
                        </div>
                        <div class="player-text">
                            <div class="name-rating-row">
                                <span class="player-name" id="playerName">You</span>
                                <span class="rating-badge" id="playerRating">1540</span>
                                <span class="player-role-tag" id="playerLabel">Connecting...</span>
                            </div>
                            <!-- Player captured pieces tray -->
                            <div class="captured-tray" id="playerCaptured">
                                <div class="captured-pieces" id="playerCapturedPieces"></div>
                                <span class="material-lead" id="playerMaterialLead"></span>
                            </div>
                        </div>
                    </div>

                    <div class="player-timing">
                        <div class="turn-indicator" id="playerTurnBadge">
                            <span class="turn-dot"></span>
                            <span class="turn-text">TURN</span>
                        </div>
                        <div class="clock-wrap">
                            <div class="chess-clock" id="playerClock">10:00</div>
                            <span class="increment-indicator" id="playerIncrement"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── Right Panel: Moves, Chat & Controls ── -->
            <aside class="right-panel">
                <!-- Match & Game Status Card -->
                <div class="panel-card game-status-card">
                    <div class="status-header">
                        <div class="match-type" id="matchTypeWrap">
                            <svg viewBox="0 0 24 24" fill="currentColor" class="match-icon">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                            </svg>
                            <select id="timeControlSelect" class="time-control-select" title="Change Time Control">
                                <optgroup label="Bullet">
                                    <option value="1+0">1+0 • Bullet</option>
                                    <option value="2+1">2+1 • Bullet</option>
                                </optgroup>
                                <optgroup label="Blitz">
                                    <option value="3+0">3+0 • Blitz</option>
                                    <option value="3+2">3+2 • Blitz</option>
                                    <option value="5+0">5+0 • Blitz</option>
                                </optgroup>
                                <optgroup label="Rapid">
                                    <option value="10+0" selected>10+0 • Rapid</option>
                                    <option value="10+5">10+5 • Rapid</option>
                                    <option value="15+10">15+10 • Rapid</option>
                                </optgroup>
                                <optgroup label="Classical">
                                    <option value="30+0">30+0 • Classical</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="game-turn-pill" id="gameTurnPill">
                            <span class="pill-dot"></span>
                            <span id="turnStatusText">White's Turn</span>
                        </div>
                    </div>
                    
                    <!-- Captured Pieces Summary Bar -->
                    <div class="material-summary-bar">
                        <div class="material-side">
                            <span class="mat-label">White captures:</span>
                            <div class="mini-piece-list" id="whiteCapturesList"></div>
                        </div>
                        <div class="material-side">
                            <span class="mat-label">Black captures:</span>
                            <div class="mini-piece-list" id="blackCapturesList"></div>
                        </div>
                    </div>
                </div>

                <!-- Move History Table -->
                <div class="panel-card moves-card">
                    <div class="moves-card-header">
                        <div class="moves-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                            <span>Move Notation</span>
                        </div>
                        <span class="move-count-badge" id="moveCountBadge">0 moves</span>
                    </div>

                    <div class="moves-table-wrap" id="movesTableWrap">
                        <table class="moves-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>White</th>
                                    <th>Black</th>
                                </tr>
                            </thead>
                            <tbody id="movesBody">
                                <!-- Dynamically populated moves -->
                            </tbody>
                        </table>
                        <div class="no-moves-placeholder" id="noMovesMsg">
                            <span>Game in progress. Moves will record here.</span>
                        </div>
                    </div>
                    <!-- Move History Review Controls -->
                    <div class="moves-nav-bar">
                        <button class="nav-step-btn" id="btnNavFirst" title="Start Position (First)">⏮</button>
                        <button class="nav-step-btn" id="btnNavPrev" title="Previous Move (Left Arrow)">◀</button>
                        <button class="nav-step-btn" id="btnNavNext" title="Next Move (Right Arrow)">▶</button>
                        <button class="nav-step-btn" id="btnNavLast" title="Latest Move">⏭</button>
                        <button class="nav-live-btn active" id="btnNavLive" title="Return to Live Position">
                            <span class="live-dot"></span> LIVE
                        </button>
                    </div>
                </div>

                <!-- Chat & Controls Area -->
                <div class="panel-card interactions-card">
                    <!-- Action Buttons -->
                    <div class="game-action-toolbar">
                        <button class="action-btn btn-draw" id="btnOfferDraw" title="Offer a draw to opponent" disabled>
                            ½ Draw
                        </button>
                        <button class="action-btn btn-resign" id="btnResign" title="Resign game" disabled>
                            ⚑ Resign
                        </button>
                        <button class="action-btn btn-rematch" id="btnRematch" title="Request rematch with swapped colors" disabled>
                            🔄 Rematch
                        </button>
                        <button class="action-btn btn-newgame-sm" id="btnQuickNewGame" title="Start a new game">
                            ⚡ New Game
                        </button>
                        <button class="action-btn btn-leave" id="btnLeaveGame" title="Leave seat and spectate" disabled>
                            🚪 Leave
                        </button>
                        <button class="action-btn btn-flip" id="btnFlip" title="Flip Board Perspective">
                            🔀 Flip
                        </button>
                        <button class="action-btn btn-lobby" id="btnReturnToLobby" title="Return to Lobby">
                            🏠 Lobby
                        </button>
                    </div>

                    <!-- Chat Header -->
                    <div class="chat-header">
                        <div class="chat-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>Game Chat & Activity</span>
                        </div>
                    </div>

                    <!-- Chat Messages Log -->
                    <div class="chat-log" id="chatLog">
                        <!-- Populated dynamically -->
                    </div>

                    <!-- Chat Input Form -->
                    <form class="chat-input-bar" id="chatForm">
                        <input
                            type="text"
                            id="chatInput"
                            placeholder="Type a message..."
                            maxlength="150"
                            autocomplete="off"
                        >
                        <button type="submit" class="btn-chat-send" id="btnChatSend" title="Send message">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </aside>
        </main>
    </div>

    <!-- ─── Game Over Modal ────────────────────────────────────── -->
    <div class="modal-overlay" id="gameOverModal">
        <div class="modal">
            <div class="modal-icon" id="modalIcon">♔</div>
            <div class="modal-outcome" id="modalOutcome">You Won!</div>
            <div class="modal-title" id="modalTitle">CHECKMATE</div>
            <div class="modal-message" id="modalMessage">Result details</div>
            <div class="modal-rating-badge" id="modalRatingBadge" style="display: none;">
                <span class="rating-badge-category" id="modalRatingCategory">RAPID</span>
                <span class="rating-badge-change text-emerald" id="modalRatingChange">+16</span>
                <span class="rating-badge-new" id="modalRatingNew">(1556)</span>
            </div>
            <div class="modal-actions dual">
                <button class="btn btn-rematch-action" id="btnModalRematch">🔄 Rematch</button>
                <button class="btn btn-newgame" id="btnModalNewGame">⚡ New Game</button>
            </div>
            <div class="modal-subactions">
